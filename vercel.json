{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix admin ci",
  "buildCommand": "npm --prefix admin run build && npm --prefix admin run sync:public -- --soft",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/admin/assets/(.*)$",
      "dest": "/admin-dist/assets/$1"
    },
    {
      "src": "^/admin/?$",
      "dest": "/admin-dist/index.html"
    },
    {
      "src": "^/admin/.*$",
      "dest": "/admin-dist/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
